{
  "manifest_version": 3,
  "name": "BABASITARAM PRO",
  "version": "9.2.4",
  "description": "Ultimate Privacy Shield: 100k+ Ad Rules + Vault + Focus Mode + Emergency Burn + Tab Isolation + Element Picker + Breach Alert",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "browsingData",
    "history",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "alarms",
    "webNavigation",
    "idle",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vault-blocked.html",
        "timelimit.html",
        "focus-blocked.html",
        "focus-mode.html",
        "filter-list-worker.js",
        "filter-sync.js",
        "newtab.js",
        "onboarding.html",
        "burn.html",
        "burned.html",
        "burned.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-chrome.js"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "custom-rules-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "password-guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "element-picker.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}